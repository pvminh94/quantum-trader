# ═══════════════════════════════════════════════════════════════════
# .env.example - Environment variables for QuantumTrader
# Copy to .env before running: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_PASSWORD=QuantumTrader2024!

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=QuantumTrader2024!

# ── JWT Secret (at least 32 characters) ────────────────────────
JWT_SECRET_KEY=change-me-to-a-secure-random-key-at-least-32-chars

# ── AES-256 Master Key (Base64, 32 bytes) ─────────────────────
# Generate with: openssl rand -base64 32
TRADING_ENGINE_MASTER_KEY=

# ── pgAdmin (debug only) ──────────────────────────────────────
PGADMIN_PASSWORD=admin123