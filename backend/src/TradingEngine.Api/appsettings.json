// ═══════════════════════════════════════════════════════════════════
// appsettings.json - Production configuration.
// ═══════════════════════════════════════════════════════════════════

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "TradingEngine": "Debug"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },

  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://trader.example.com"
  ],

  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=trading_engine;Username=trading;Password=CHANGE_ME;Pooling=true;MaxPoolSize=100;Keepalive=60;",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=5000,syncTimeout=1000,keepAlive=60"
  },

  "Jwt": {
    "Issuer": "TradingEngine",
    "Audience": "TradingDashboard",
    "SecretKey": "CHANGE-ME-IN-PRODUCTION-AT-LEAST-32-CHARACTERS-LONG!!!",
    "ExpirationHours": 24
  },

  "Exchange": {
    "Binance": {
      "BaseUrl": "https://api.binance.com",
      "WsUrl": "wss://stream.binance.com:9443/ws",
      "RateLimitPerSecond": 20,
      "RateLimitPerMinute": 1200
    },
    "Mexc": {
      "BaseUrl": "https://api.mexc.com",
      "WsUrl": "wss://wbs.mexc.com/ws"
    }
  },

  "Redis": {
    "Channels": {
      "OrderBookPrefix": "orderbook:",
      "TradePrefix": "trades:",
      "TickerPrefix": "ticker:",
      "KlinePrefix": "kline:"
    },
    "ExpirationSeconds": {
      "OrderBook": 5,
      "TradeHistory": 3600,
      "Ticker": 5,
      "KlineHistory": 86400
    }
  },

  "CircuitBreaker": {
    "MaxDailyDrawdownPercent": 10,
    "MaxConsecutiveLosses": 5,
    "Enabled": true
  },

  "RateLimiting": {
    "Api": {
      "MaxRequestsPerMinute": 1200,
      "MaxRequestsPerSecond": 20
    },
    "SignalR": {
      "MaxInvocationsPerMinute": 600
    }
  },

  "HealthChecks": {
    "PollingIntervalSeconds": 15,
    "DegradedThresholdMs": 5000,
    "UnhealthyThresholdMs": 15000
  }
}